# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다. 키를 채팅이나 문서에 붙이지 않는다.
APP_ENV=dev
# 공공데이터포털 인증키 (scripts/collect_rent.py 에서만 쓴다)
# 마이페이지의 일반 인증키. Encoding 키와 Decoding 키 중 아무거나 넣어도 된다
DATA_GO_KR_KEY=
# API 마다 키가 다를 때만 채운다. 비어 있으면 위의 DATA_GO_KR_KEY 를 쓴다
DATA_GO_KR_KEY_OFFICETEL=
DATA_GO_KR_KEY_DETACHED_MULTI=
DATA_GO_KR_KEY_ROW_MULTI=
# LLM: Claude(Anthropic API)로 가정. 모델은 팀이 정한다(예: claude-sonnet-5-5, 비용을 줄이려면 claude-haiku-5-5)
# 비워 두면 LLM 없이 대체 흐름으로 동작한다
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# 사용량 한도 (0 이면 끔). 마감 전에 값을 정한다
RATE_LIMIT_PER_IP_PER_DAY=0
RATE_LIMIT_TOTAL_PER_DAY=0
